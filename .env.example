# ============================================================
# Raízes do Nordeste - Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e ajuste os valores
# ============================================================

# Banco de dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/raizes_nordeste
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Segredo JWT (mínimo 256 bits / 32 caracteres)
JWT_SECRET=raizes-nordeste-secret-key-troque-em-producao
JWT_EXPIRATION=86400000

# Porta da aplicação (opcional, padrão 8080)
SERVER_PORT=8080
